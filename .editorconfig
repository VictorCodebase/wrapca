root = true

[*]
# Use tabs for indentation
indent_style = tab
# Number of columns used for each indentation level
indent_size = 4
# Width of a single tab character
tab_width = 4

# Forces hard line wrapping after 120 characters
max_line_length = 120
# IntelliJ-specific: ensures wrapping occurs during typing/reformatting
ij_wrap_on_typing = true
